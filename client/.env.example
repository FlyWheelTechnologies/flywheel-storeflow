# FlorzyAngel Enterprise — Environment Variables
# Copy this to .env.local and fill in your Supabase credentials

# ── Supabase ──────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── App ───────────────────────────────────────────
VITE_APP_NAME=FlorzyAngel Hardware Management Suite
VITE_CURRENCY=GHS

# ── Notifications (Phase 3) ───────────────────────
# VITE_TWILIO_WHATSAPP_FROM=
# VITE_RESEND_API_KEY=

# ── Telemetry & Diagnostics (PostHog) ───────────────
# VITE_POSTHOG_KEY=phc_YOUR_POSTHOG_PROJECT_API_KEY
# VITE_POSTHOG_HOST=https://us.i.posthog.com # or https://eu.i.posthog.com
